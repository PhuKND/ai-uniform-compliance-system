# Root integrated AI server configuration.
# Copy to .env if you need local overrides. Do not commit real .env files.

# Uniform AI server
UNIFORM_PORT=5001
UNIFORM_DEBUG=0
UNIFORM_FORCE_CPU=0
UNIFORM_PERSIST_UPLOADS=0
UNIFORM_MAX_CONTENT_MB=15
UNIFORM_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
UNIFORM_UPLOAD_DIR=uploads
UNIFORM_OUTPUT_DIR=outputs
UNIFORM_WEIGHTS_DIR=weights
UNIFORM_STORAGE_DIR=storage/uniform
UNIFORM_PRE_AI_IMAGE_DIR=storage/uniform/pre_ai
UNIFORM_EVALUATION_RECORD_DIR=storage/uniform/evaluations
UNIFORM_SELECTION_RECORD_DIR=storage/uniform/selections
UNIFORM_PRE_AI_IMAGE_MAX_BYTES=1048576
UNIFORM_PRE_AI_IMAGE_MIN_BYTES=786432
UNIFORM_SCHP_REPO_DIR=third_party/schp
UNIFORM_SCHP_CHECKPOINT=weights/exp-schp-201908301523-atr.pth
UNIFORM_GD_BOX_THRESHOLD=0.30
UNIFORM_GD_TEXT_THRESHOLD=0.25
UNIFORM_REQUIRED_ITEM_THRESHOLD=0.33
UNIFORM_SHIRT_POLICY=white_or_youth_union
UNIFORM_REQUIRE_RED_SCARF=true
UNIFORM_TUCK_IN_TOLERANCE_RATIO=0.03
UNIFORM_TUCK_IN_FAIL_RATIO=0.11

# YOLOv8 V2 six-class uniform detector
UNIFORM_AI_YOLOV8_V2_ENABLED=true
UNIFORM_AI_YOLOV8_V2_DIR=yolov8_6class
UNIFORM_AI_YOLOV8_V2_WEIGHTS=yolov8_6class/best.pt
UNIFORM_AI_YOLOV8_V2_CONF=0.25
UNIFORM_AI_YOLOV8_V2_IMGSZ=640
UNIFORM_AI_YOLOV8_V2_MAX_DET=30
UNIFORM_AI_YOLOV8_V2_UNIQUE_PER_CLASS=true
UNIFORM_AI_YOLOV8_V2_DEVICE=auto
UNIFORM_AI_YOLOV8_V2_STRICT_CLASS_MAPPING=true
UNIFORM_AI_GROUNDING_DINO_V2_ENABLED=true
UNIFORM_YOLO_OUTPUT_DIR=outputs/yolov8
UNIFORM_YOLO_CONF=0.25
UNIFORM_YOLO_IMGSZ=640
UNIFORM_YOLO_MAX_DET=30
UNIFORM_YOLO_SAVE_ANNOTATED=true

# Human pose estimation and target-person association
UNIFORM_POSE_MODEL=yolov8n-pose.pt
UNIFORM_POSE_IMGSZ=640
UNIFORM_POSE_PERSON_CONF=0.25
UNIFORM_POSE_MIN_KEYPOINT_CONF=0.40
UNIFORM_POSE_MIN_VALID_KEYPOINTS=5
UNIFORM_TARGET_PERSON_PADDING_RATIO=0.15
UNIFORM_MIN_COMPONENT_POSE_OVERLAP_RATIO=0.20
UNIFORM_MIN_SCARF_POSE_OVERLAP_RATIO=0.08
UNIFORM_MIN_COMPONENT_BODY_OVERLAP_RATIO=0.05
UNIFORM_MAX_COMPONENT_CENTER_DISTANCE_RATIO=0.35
UNIFORM_MIN_FACE_POSE_OVERLAP_RATIO=0.03
UNIFORM_MAX_FACE_HEAD_DISTANCE_RATIO=0.28
UNIFORM_MIN_FACE_POSE_MATCH_SCORE=0.18
UNIFORM_SHOW_REJECTED_DETECTIONS=true

# Face recognition
FACE_SIMILARITY_THRESHOLD=0.5
FACE_STORAGE_DIR=storage
FACE_UPLOAD_DIR=storage/uploads
FACE_EMBEDDING_DIR=storage/embeddings
FACE_METADATA_FILE=storage/students.json
FACE_ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
FACE_MAX_CONTENT_LENGTH_MB=8
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_MODEL_ROOT=
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_DET_SIZE=640,640
